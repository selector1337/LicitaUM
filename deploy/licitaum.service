[Unit]
Description=LicitaUM
After=network.target

[Service]
Type=simple
User=licitaum
Group=licitaum
WorkingDirectory=/opt/licitaum
Environment=LICITAUM_HOST=127.0.0.1
Environment=LICITAUM_PORT=8765
ExecStart=/opt/licitaum/.venv/bin/python /opt/licitaum/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
